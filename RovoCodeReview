import requests
import json

def create_github_pull_request(owner, repo, title, body, head_branch, base_branch, github_token):
    """
    Creates a new pull request on GitHub.

    Args:
        owner (str): The owner of the repository.
        repo (str): The name of the repository.
        title (str): The title of the pull request.
        body (str): The body/description of the pull request.
        head_branch (str): The branch containing the changes to be merged.
        base_branch (str): The branch to merge the changes into.
        github_token (str): Your GitHub Personal Access Token.

    Returns:
        dict: The JSON response from the GitHub API, or None if an error occurred.
    """
    url = f"https://api.github.com/repos/{owner}/{repo}/pulls"
    headers = {
        "Authorization": f"token {github_token}",
        "Accept": "application/vnd.github.v3+json",
        "Content-Type": "application/json"
    }
    payload = {
        "title": title,
        "body": body,
        "head": head_branch,
        "base": base_branch
    }

    try:
        response = requests.post(url, headers=headers, data=json.dumps(payload))
        response.raise_for_status()  # Raise an exception for bad status codes (4xx or 5xx)
        return response.json()
    except requests.exceptions.RequestException as e:
        print(f"Error creating pull request: {e}")
        if hasattr(e, 'response') and e.response is not None:
            print(f"Response content: {e.response.text}")
        return None

